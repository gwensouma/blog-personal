# Copy this file to .env.local and adjust values.

# Port for the dev/start server. Change this if it conflicts with another process.
PORT=3000

# Public origin of the deployed site, without a trailing slash. Used for canonical
# URLs, Open Graph, the sitemap, RSS and JSON-LD. Must be set for production builds;
# it falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com
