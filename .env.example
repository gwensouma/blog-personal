# Copy this file to .env.local and adjust values. .env.local is gitignored; never commit secrets.
# CI needs none of these (the e2e job sets BLOG_DATA_DIR itself); put any future CI secret in GitHub Secrets.

# Port for `npm run dev` / `npm run start`. Change it if it conflicts with another process.
PORT=3000

# Public origin of the deployed site, without a trailing slash. Used for canonical
# URLs, Open Graph, the sitemap, RSS and JSON-LD. Must be set for production builds;
# it falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# Directory of the JSON store (likes, views, subscribers), relative to the project root.
# Defaults to .data. Playwright uses .data-e2e so tests never touch real data.
# BLOG_DATA_DIR=.data

# --- Planned for sprints 9-10 (comments and /admin); not read by the code yet ---

# Admin login for /admin. If either is unset, /admin returns 404.
# ADMIN_PASSWORD=change-me
# Secret that signs the admin session cookie (HMAC-SHA256). Use 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs every admin out.
# ADMIN_SESSION_SECRET=

# Set to 1 only behind a proxy you trust to set X-Forwarded-For. Rate limits then key on the
# left-most address; otherwise they fall back to one site-wide flood guard.
# TRUST_PROXY=0
