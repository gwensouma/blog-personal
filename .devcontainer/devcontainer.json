// Open with VS Code: "Dev Containers: Clone Repository in Container Volume..." (see README, Setup).
// Based on https://github.com/anthropics/claude-code/blob/main/.devcontainer/devcontainer.json.
{
  "name": "blog-personal",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Asia/Ho_Chi_Minh}",
      "CLAUDE_CODE_VERSION": "latest",
      "PLAYWRIGHT_VERSION": "1.64.0"
    }
  },
  // The firewall needs these to manage iptables inside the container.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "node",
  "mounts": [
    "source=blog-personal-claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=blog-personal-history-${devcontainerId},target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    // Claude Code keeps its sign-in, settings, memory and sessions in this volume, so they survive rebuilds.
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint"]
    }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
